# Kopieer naar .env en vul in. Zet .env NOOIT in git.

# --- Modus -------------------------------------------------------------
# false = paper trading (standaard, geen echte orders)
LIVE_TRADING=false

# --- Bitvavo -------------------------------------------------------------
# Alleen nodig voor live trading. Maak een key aan met ALLEEN "Trade"-rechten,
# zonder opnamerechten, en koppel hem aan het IP-adres van je server.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# --- Markt en strategie ---------------------------------------------------
PAIRS=BTC/EUR,ETH/EUR
TIMEFRAME=1h
CHECK_INTERVAL_MINUTES=15
EMA_FAST=12
EMA_SLOW=26
RSI_PERIOD=14
RSI_MAX_ENTRY=70

# --- Harde limieten (de AI kan hier niet aan komen) -----------------------
STAKE_EUR=25
MAX_OPEN_TRADES=2
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
MAX_DAILY_LOSS_EUR=20
FEE_PCT=0.25
PAPER_START_BALANCE_EUR=500

# --- AI-veto --------------------------------------------------------------
# none   = geen AI, elk signaal wordt doorgelaten
# gemini = Google Gemini (gratis tier via aistudio.google.com)
# openai = elke OpenAI-compatibele API, zoals Groq, OpenRouter of Ollama
AI_PROVIDER=none
AI_API_KEY=
# Leeg = standaardmodel van de provider
AI_MODEL=
# Alleen voor AI_PROVIDER=openai. Groq is de standaard.
AI_BASE_URL=https://api.groq.com/openai/v1
# reject = bij een AI-fout wordt de trade afgewezen (veilig)
AI_FAIL_MODE=reject

# --- Dashboard ------------------------------------------------------------
PORT=3000
DASHBOARD_PASSWORD=
TZ=Europe/Amsterdam
